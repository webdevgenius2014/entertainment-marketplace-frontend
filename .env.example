# ===========================================
# Out Front Entertainment - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=https://outfrontentertainment.com.au
NEXT_PUBLIC_SITE_NAME="Out Front Entertainment"

# ===========================================
# Backend API Configuration (Node.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ===========================================
# Stripe Configuration
# ===========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Platform commission percentage (e.g., 10 for 10%)
PLATFORM_COMMISSION_PERCENTAGE=10

# ===========================================
# Analytics & Tracking
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_VERIFICATION=your_google_verification_code
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# ===========================================
# Sentry Error Monitoring
# ===========================================
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ===========================================
# Feature Flags
# ===========================================
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_MESSAGING=true
NEXT_PUBLIC_MAINTENANCE_MODE=false
